#!/bin/sh
# Development launcher: runs the bea CLI this checkout has built.
# Build it first with `bea build` (an installed bea compiles src/ into
# .beabuild/); `scripts/bea build` then rebuilds it with itself. For a
# standalone binary use `bea pack`.
#
# Ctrl+C: the VM is started with `+Bi` (it ignores SIGINT, so it can never
# die while a program it started is still running) and this script turns
# the interrupt into a SIGTERM that Bea forwards to the running program
# (see src/bea_signal.erl). Bea exits once the program is gone, so nothing is
# left behind to reset the terminal after the shell has taken it back.
ROOT=$(cd "$(dirname "$0")/.." && pwd)

interrupted=
pid=
forward() {
  interrupted=$1
  [ -n "$pid" ] && kill -TERM "$pid" 2>/dev/null
}
trap 'forward 130' INT
trap 'forward 131' QUIT
trap 'forward 143' TERM
trap 'forward 129' HUP
# The VM ignores Ctrl+Z too (+Bi); don't let the job stop half way.
trap '' TSTP

# Background jobs get /dev/null as stdin unless it is redirected explicitly.
{ command exec 3<&0; } 2>/dev/null || exec 3</dev/null
erl +Bi -pa "$ROOT"/.beabuild/build/dev/erlang/*/ebin -noshell -eval 'bea:main()' -extra "$@" <&3 3<&- &
pid=$!
exec 3<&-
# Interrupted before the VM was started.
[ -n "$interrupted" ] && kill -TERM "$pid" 2>/dev/null

# `wait` returns early when a trapped signal arrives; keep waiting until the
# VM has really exited.
while :; do
  wait "$pid"
  code=$?
  kill -0 "$pid" 2>/dev/null || break
done
if [ -n "$interrupted" ]; then
  exit "$interrupted"
fi
exit "$code"
