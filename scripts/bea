#!/bin/sh
# Development launcher: runs the bea CLI from this checkout's build directory.
# Build first with `gleam build`. For a release binary use gleepack or
# `gleam export erlang-shipment`.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
exec erl -pa "$ROOT"/build/dev/erlang/*/ebin -noshell -eval 'bea:main()' -extra "$@"
