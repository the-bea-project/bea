//// Entry point of the `bea` executable.

import argv
import bea/cli
import bea/system

pub def main() -> Nil {
  system.init()
  code = cli.main(argv.load().arguments)
  // A program stopped by Ctrl+C / SIGTERM: report it like a shell would.
  code = case system.was_interrupted() {
    Ok(signal_code) -> signal_code
    Error(_) -> code
  }
  system.halt(code)
}
