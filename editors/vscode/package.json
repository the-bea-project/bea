{
  "name": "bea-vscode",
  "displayName": "Bea Language Support",
  "description": "Syntax highlighting and language support for Bea",
  "version": "0.0.1",
  "icon": "./icons/beatrix.png",
  "publisher": "bea-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bea",
        "aliases": ["Bea", "bea"],
        "extensions": [".bea"],
        "configuration": "./language-configuration.json",

        "icon": {
          "light": "./icons/beatrix.svg",
          "dark": "./icons/beatrix.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "bea",
        "scopeName": "source.bea",
        "path": "./syntaxes/bea.tmLanguage.json"
      }
    ]
  }
}