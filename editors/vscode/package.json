{
  "name": "bea-vscode",
  "displayName": "Bea Language Support",
  "description": "Syntax highlighting, diagnostics, completion, navigation and formatting for Bea",
  "version": "0.3.0",
  "icon": "./icons/beatrix.png",
  "publisher": "bea-lang",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/bea.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bea",
        "aliases": ["Bea", "bea"],
        "extensions": [".bea"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/beatrix.svg",
          "dark": "./icons/beatrix.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "bea",
        "scopeName": "source.bea",
        "path": "./syntaxes/bea.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Bea",
      "properties": {
        "bea.path": {
          "type": "string",
          "default": "bea",
          "description": "Path to the `bea` executable used to run the language server."
        },
        "bea.gleamPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `gleam` executable (defaults to `gleam` on the PATH)."
        },
        "bea.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace the communication between VS Code and the Bea language server."
        },
        "bea.completion.callParentheses": {
          "type": "boolean",
          "default": true,
          "description": "Complete functions with `()` and show their signature, with the cursor between the parentheses."
        },
        "bea.format.organizeImports": {
          "type": "boolean",
          "default": true,
          "description": "Organise imports when formatting: standard library, dependencies and project modules in sorted groups, unused imports removed, obvious missing ones added."
        }
      }
    },
    "configurationDefaults": {
      "[bea]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.showWords": false,
        "editor.quickSuggestions": { "other": "on", "comments": "off", "strings": "off" },
        "editor.suggestSelection": "first",
        "editor.parameterHints.enabled": true
      }
    },
    "commands": [
      {
        "command": "bea.restartServer",
        "title": "Bea: Restart Language Server"
      },
      {
        "command": "bea.showGeneratedGleam",
        "title": "Bea: Show Generated Gleam",
        "enablement": "editorLangId == bea"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "bea.showGeneratedGleam", "when": "editorLangId == bea" }
      ]
    }
  },
  "scripts": {
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  }
}
