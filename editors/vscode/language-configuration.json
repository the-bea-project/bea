{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "<<", "close": ">>", "notIn": ["string", "comment"] }
  ],
  "autoCloseBefore": ";:.,=}])>| \n\t",
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\{|\\(|\\[|->)\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*[}\\])]"
  },
  "onEnterRules": [
    { "beforeText": "^\\s*////", "action": { "indent": "none", "appendText": "//// " } },
    { "beforeText": "^\\s*///", "action": { "indent": "none", "appendText": "/// " } }
  ]
}
