//// The compiler's sources (compiler/src) and the Gleam this package is
//// built from (src/, generated by scripts/bootstrap.sh).
////
//// The compiler under test compiles its own source here, as the bootstrap
//// does, and must produce exactly the Gleam it was built from: a fixed
//// point. In the repository that means src/ is up to date with
//// compiler/src and the self-hosted compiler rebuilds itself unchanged; in
//// a bootstrap stage's package (scripts/verify_bootstrap.sh runs the tests
//// there), that this stage's compiler compiles compiler/src exactly like
//// the compiler that generated it.

import bea/project
import bea/system
import gleam/dict
import gleam/list
import gleam/result
import gleam/string
import simplifile

const sources = "compiler/src"

const generated = "src"

const manifest = "src/.bea-generated"

const rerun = "run scripts/bootstrap.sh to regenerate src/ from compiler/src"

/// Files under `dir`, relative to it, sorted.
fn files(dir: String) -> List(String) {
  let assert Ok(paths) = simplifile.get_files(dir)
  paths
  |> list.map(string.drop_start(_, string.length(dir) + 1))
  |> list.sort(string.compare)
}

/// The Gleam module a compiler source becomes: `x.bea` is compiled to
/// `x.gleam`, anything else (Gleam modules, Erlang FFI) is copied.
fn output_path(source: String) -> String {
  case string.ends_with(source, ".bea") {
    True -> string.drop_end(source, 4) <> ".gleam"
    False -> source
  }
}

/// Compiles compiler/src as one Bea project, like the bootstrap does.
fn compile_compiler_sources() -> #(project.Project, project.Sync) {
  let root = system.absolute_path("build/bea_test_projects/self_hosting")
  let _ = simplifile.delete(root)
  let assert Ok(_) = simplifile.create_directory_all(root)
  let assert Ok(config) = simplifile.read("gleam.toml")
  let assert Ok(_) = simplifile.write(root <> "/bea.toml", config)
  let assert Ok(_) = simplifile.copy_directory(sources, root <> "/src")
  let assert Ok(p) = project.find(root)
  #(p, project.sync(p, dict.new()))
}

pub fn compiler_compiles_its_own_source_to_this_package_test() {
  let #(p, sync) = compile_compiler_sources()
  // No diagnostic of any kind for the compiler's own source.
  assert list.map(sync.errors, fn(e) { e.path }) == []
  assert list.map(sync.warnings, fn(w) { w.path }) == []
  let built = p.build_dir <> "/src"
  let outputs = files(built)
  assert outputs
    == list.map(files(sources), output_path) |> list.sort(string.compare)
  list.each(outputs, fn(f) {
    let assert Ok(expected) = simplifile.read(built <> "/" <> f)
    let actual = simplifile.read(generated <> "/" <> f)
    case actual == Ok(expected) {
      True -> Nil
      False ->
        panic as {
          "src/"
          <> f
          <> " is not what this compiler generates from compiler/src: "
          <> rerun
        }
    }
  })
}

pub fn generated_sources_come_from_compiler_sources_test() {
  // Everything in src/ is generated from (or a copy of) compiler/src, and
  // every compiler source has its module there.
  let expected =
    list.map(files(sources), output_path) |> list.sort(string.compare)
  let actual = files(generated) |> list.filter(fn(f) { f != ".bea-generated" })
  case actual == expected {
    True -> Nil
    False ->
      panic as {
        "src/ and compiler/src don't match ("
        <> string.join(
          list.append(
            list.filter(actual, fn(f) { !list.contains(expected, f) })
              |> list.map(fn(f) { "extra src/" <> f }),
            list.filter(expected, fn(f) { !list.contains(actual, f) })
              |> list.map(fn(f) { "missing src/" <> f }),
          ),
          ", ",
        )
        <> "): "
        <> rerun
      }
  }
}

pub fn no_module_is_written_in_both_languages_test() {
  let modules =
    files(sources)
    |> list.filter_map(fn(f) {
      case string.ends_with(f, ".bea"), string.ends_with(f, ".gleam") {
        True, _ -> Ok(string.drop_end(f, 4))
        _, True -> Ok(string.drop_end(f, 6))
        _, _ -> Error(Nil)
      }
    })
  assert list.unique(modules) == modules
}

pub fn generated_sources_are_listed_in_the_manifest_test() {
  // The bootstrap records what it wrote in src/.bea-generated, so it can
  // refuse to overwrite files edited by hand. In the repository the file
  // must exist (a bootstrap stage's package has no manifest).
  case simplifile.read(manifest), in_repository() {
    Error(_), False -> Nil
    Error(_), True -> panic as { "src/.bea-generated is missing: " <> rerun }
    Ok(text), _ -> {
      let listed =
        text
        |> string.split("\n")
        |> list.filter(fn(l) { l != "" && !string.starts_with(l, "#") })
        |> list.map(fn(l) {
          let assert Ok(#(hash, path)) = string.split_once(l, "  ")
          assert string.length(hash) == 64
          string.drop_start(path, 2)
        })
      assert listed
        == files(generated) |> list.filter(fn(f) { f != ".bea-generated" })
    }
  }
}

pub fn trusted_seed_is_pinned_test() {
  let assert Ok(seed) = simplifile.read("bootstrap/seed.env")
  let value = fn(key) {
    seed
    |> string.split("\n")
    |> list.find_map(fn(l) {
      case string.split_once(l, "=") {
        Ok(#(k, v)) if k == key -> Ok(v)
        _ -> Error(Nil)
      }
    })
  }
  let assert Ok(tree) = value("SEED_TREE")
  assert string.length(tree) == 40
  assert string.to_graphemes(tree)
    |> list.all(fn(c) { string.contains("0123456789abcdef", c) })
  assert value("SEED_SUBJECT") |> result.is_ok
}

fn in_repository() -> Bool {
  case simplifile.is_directory(".git"), simplifile.is_file(".git") {
    Ok(True), _ | _, Ok(True) -> True
    _, _ -> False
  }
}
