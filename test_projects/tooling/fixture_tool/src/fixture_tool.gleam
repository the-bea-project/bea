//// A stand-in for a Gleam tool such as Marmot, run with
//// `gleam run -m fixture_tool` (or `bea run -m fixture_tool`).
////
//// Like Marmot it reads `[tools.fixture_tool]` from the `gleam.toml` of the
//// directory it runs in and generates a Gleam module in `src/`.

import argv
import gleam/int
import gleam/io
import gleam/list
import gleam/result
import gleam/string
import simplifile

pub fn main() -> Nil {
  case argv.load().arguments {
    ["help", ..] -> io.println(help())
    ["echo", ..args] -> {
      args
      |> list.map(fn(a) { "[" <> a <> "]" })
      |> string.join(" ")
      |> io.println
      io.println_error("echo: done")
    }
    ["fail", code] -> {
      io.println_error("fixture_tool: failing with " <> code)
      halt(int.parse(code) |> result.unwrap(1))
    }
    ["config"] ->
      case config_greeting() {
        Ok(greeting) -> io.println("greeting from gleam.toml: " <> greeting)
        Error(message) -> {
          io.println_error(message)
          halt(1)
        }
      }
    [] -> generate([])
    [first, ..] as args ->
      case string.starts_with(first, "-") {
        True -> generate(args)
        False -> {
          io.println_error(
            "error: unknown command " <> first <> "\n\n" <> help(),
          )
          halt(2)
        }
      }
  }
}

fn help() -> String {
  "fixture_tool help

Usage:
  gleam run -m fixture_tool [-- --greeting TEXT]
  gleam run -m fixture_tool echo ARGS...
  gleam run -m fixture_tool fail CODE
  gleam run -m fixture_tool config
  gleam run -m fixture_tool help"
}

/// `greeting = "..."` in the `[tools.fixture_tool]` section of gleam.toml.
fn config_greeting() -> Result(String, String) {
  use toml <- result.try(
    simplifile.read("gleam.toml")
    |> result.replace_error("error: Could not read gleam.toml"),
  )
  toml
  |> string.split("[tools.fixture_tool]")
  |> list.drop(1)
  |> list.first
  |> result.try(fn(section) { string.split_once(section, "greeting = \"") })
  |> result.try(fn(parts) { string.split_once(parts.1, "\"") })
  |> result.map(fn(parts) { parts.0 })
  |> result.replace_error("error: no greeting in [tools.fixture_tool]")
}

fn generate(args: List(String)) -> Nil {
  let greeting = case args {
    ["--greeting", greeting, ..] -> greeting
    _ -> config_greeting() |> result.unwrap("Hello")
  }
  let dir = "src/generated/sql"
  let path = dir <> "/example_sql.gleam"
  let assert Ok(_) = simplifile.create_directory_all(dir)
  let assert Ok(_) = simplifile.write(path, module(greeting))
  io.println("wrote " <> path)
}

fn module(greeting: String) -> String {
  "//// Generated by fixture_tool.

import gleam/int

pub type GreetingRow {
  GreetingRow(id: Int, text: String)
}

pub fn find_greeting(
  db db: String,
  id id: Int,
) -> Result(List(GreetingRow), String) {
  case id {
    1 -> Ok([GreetingRow(id: 1, text: \"" <> greeting <> " from \" <> db)])
    _ -> Error(\"no greeting \" <> int.to_string(id))
  }
}
"
}

@external(erlang, "erlang", "halt")
@external(javascript, "./fixture_tool_ffi.mjs", "halt")
fn halt(code: Int) -> Nil
