//// Library modules built into Bea: the JSON derivers `bea_json/decoder`
//// and `bea_json/encoder`, for `@derive(decoder)` and `@derive(encoder)`.
////
//// A project that imports one of them and doesn't define a module of that
//// name itself (nor gets one from a dependency) gets it written into its
//// build directory, compiled from the Bea source below, like one of its
//// own modules. They use `gleam_json`, which the project must depend on.
////
//// The sources are raw strings, so they hold no backticks.

/// Built-in modules: name and Bea source.
pub def modules() -> List((String, String)) {
  [("bea_json/decoder", json_decoder), ("bea_json/encoder", json_encoder)]
}

/// The package the built-in modules need, as a direct dependency.
pub const dependency = "gleam_json"

const json_decoder = `//// JSON decoders for '@derive(decoder)', built into Bea:
////
////     import bea_json/decoder
////
////     @derive(decoder)
////     pub type Credentials { username: String, password: String }
////
////     credentials = decoder.from_json(body, Credentials.decoder())?
////
//// A derived decoder is a plain 'decode.Decoder' from the standard
//// library, so it works with 'json.parse', 'decode.run' on any 'Dynamic',
//// and every Gleam library that takes decoders.
////
//// The conventions are this module's, not the compiler's: a record is an
//// object with a key per field label; a field whose decoder accepts 'null'
//// (an 'Option') may also be left out; an integer is accepted where a float
//// is expected; errors are the standard library's, with the path to the
//// failing value.

import gleam/dynamic
import gleam/dynamic/decode.{type Decoder}
import gleam/json

// --- What '@derive(decoder)' calls --------------------------------------------------

/// A record is decoded from its fields.
pub def record(_constructor: String, fields: fn() -> Decoder(r)) -> Decoder(r) {
  fields()
}

/// One field, under its label. Missing is the same as 'null': fine when the
/// field's decoder accepts 'null', a "missing field" error otherwise.
pub def field(
  label: String,
  of: Decoder(a),
  _get: fn(r) -> a,
  next: fn(a) -> Decoder(r),
) -> Decoder(r) {
  case decode.run(dynamic.nil(), of) {
    Ok(when_missing) -> decode.optional_field(label, when_missing, of, next)
    Error(_) -> decode.field(label, of, next)
  }
}

pub def done(value: r) -> Decoder(r) {
  decode.success(value)
}

// --- Decoders for the types fields can have -------------------------------------------

pub def string() -> Decoder(String) {
  decode.string
}

pub def int() -> Decoder(Int) {
  decode.int
}

pub def bool() -> Decoder(Bool) {
  decode.bool
}

/// JSON doesn't tell '1' from '1.0': both are fine for a 'Float'.
pub def float() -> Decoder(Float) {
  decode.one_of(decode.float, [decode.int |> decode.map(int.to_float)])
}

pub def list(of: Decoder(a)) -> Decoder(List(a)) {
  decode.list(of)
}

/// 'null' is 'None'.
pub def option(of: Decoder(a)) -> Decoder(Option(a)) {
  decode.optional(of)
}

pub def dict(keys: Decoder(k), values: Decoder(v)) -> Decoder(Dict(k, v)) {
  decode.dict(keys, values)
}

// --- Running ------------------------------------------------------------------------

pub def from_json(
  text: String,
  decoder: Decoder(a),
) -> Result(a, json.DecodeError) {
  json.parse(text, decoder)
}
`

const json_encoder = `//// A deriver of JSON encoders: '@derive(encoder)' on 'User' defines
//// 'user_encoder()', a 'fn(User) -> Json'.
////
//// Conventions: a record is an object with a key per field label, 'None'
//// is 'null', and dictionaries need 'String' keys (anything else doesn't
//// type check).

import gleam/json.{type Json}

pub type Encoder(a) = fn(a) -> Json

/// The fields of a record, as JSON object entries.
pub opaque type Fields(r) {
  Fields(entries: fn(r) -> List((String, Json)))
}

// --- What '@derive(encoder)' calls --------------------------------------------------

pub def record(_constructor: String, fields: fn() -> Fields(r)) -> Encoder(r) {
  fn(value) { json.object(fields().entries(value)) }
}

pub def field(
  label: String,
  of: Encoder(a),
  get: fn(r) -> a,
  next: fn(a) -> Fields(r),
) -> Fields(r) {
  Fields(fn(record) {
    value = get(record)
    [(label, of(value)) | next(value).entries(record)]
  })
}

pub def done(_value: r) -> Fields(r) {
  Fields(fn(_) { [] })
}

// --- Encoders for the types fields can have -------------------------------------------

pub def string() -> Encoder(String) {
  json.string
}

pub def int() -> Encoder(Int) {
  json.int
}

pub def float() -> Encoder(Float) {
  json.float
}

pub def bool() -> Encoder(Bool) {
  json.bool
}

pub def list(of: Encoder(a)) -> Encoder(List(a)) {
  fn(values) { json.array(values, of) }
}

pub def option(of: Encoder(a)) -> Encoder(Option(a)) {
  fn(value) { json.nullable(value, of) }
}

pub def dict(
  _keys: Encoder(String),
  values: Encoder(v),
) -> Encoder(Dict(String, v)) {
  fn(value) { json.dict(value, fn(key) { key }, values) }
}

// --- Running ------------------------------------------------------------------------

pub def to_json(value: a, encoder: Encoder(a)) -> Json {
  encoder(value)
}

pub def to_string(value: a, encoder: Encoder(a)) -> String {
  encoder(value) |> json.to_string
}
`
