//// Bea projects and the generated Gleam project behind them.
////
//// A Bea project is a directory with a `bea.toml` (same format as
//// `gleam.toml`) and a `src/` directory. Bea mirrors it into `.beabuild/`:
////
//// - `bea.toml` becomes `.beabuild/gleam.toml`
//// - `manifest.toml` is kept in sync in both directions (the root copy is
////   the lock file you commit)
//// - every `src/**/*.bea` is compiled to `.beabuild/src/**/*.gleam`
//// - every other source file Gleam understands (`.gleam`, `.erl`, `.hrl`,
////   `.mjs`, `.js`, `.ts`, ...) is copied unchanged, so Bea and Gleam
////   modules (and FFI files) can live side by side and import each other.
////   That includes code that tools generate in `src/` (such as Marmot's
////   `src/generated/sql/`): it stays where the tool wrote it, Bea only ever
////   writes to `.beabuild/`, and a copy is refreshed or removed whenever
////   its source changes or goes away, so the build never uses stale code.
//// - the built-in modules (`bea/builtins`: the JSON derivers
////   `bea_json/decoder` and `bea_json/encoder`) the project imports are
////   written to `.beabuild/src/` too, unless the project or a dependency
////   has a module of that name
////
//// Files are only rewritten when their content changes, which keeps Gleam's
//// incremental compilation effective.
////
//// Running `bea run some/file.bea` outside a project uses "script mode": the
//// file's directory acts as `src/`, with a default configuration.

import bea/ast
import bea/builtins
import bea/codegen
import bea/compiler
import bea/deriving
import bea/diagnostic.{type Diagnostic}
import bea/sourcemap.{type SourceMap}
import bea/span
import bea/system
import gleam/dict.{type Dict}
import gleam/int
import gleam/list
import gleam/option.{type Option, None, Some}
import gleam/result
import gleam/set.{type Set}
import gleam/string
import simplifile

pub type Project {
  Project(
    /// Absolute path of the directory holding `bea.toml`.
    root: String,
    /// Absolute path of the source directory.
    src_dir: String,
    /// Absolute path of the generated Gleam project.
    build_dir: String,
    name: String,
    /// True for script mode (no `bea.toml`).
    script: Bool,
    config: String,
  )
}

pub const config_file = "bea.toml"

pub const build_dir_name = ".beabuild"

pub def default_config(name: String) -> String {
  "name = \"" <> name <> "\"\nversion = \"1.0.0\"\n\n[dependencies]\ngleam_stdlib = \">= 0.44.0 and < 2.0.0\"\n"
}

/// Find the project containing `dir` by looking for `bea.toml` upwards.
pub def find(dir: String) -> Result(Project, Nil) {
  dir = system.absolute_path(dir)
  case simplifile.read(dir <> "/" <> config_file) {
    Ok(config) ->
      Ok(
        Project(
          root: dir,
          src_dir: dir <> "/src",
          build_dir: dir <> "/" <> build_dir_name,
          name: package_name(config) |> result.unwrap("bea_app"),
          script: False,
          config: config,
        ),
      )
    Error(_) -> case parent(dir) {
      Ok(p) -> find(p)
      Error(_) -> Error(Nil)
    }
  }
}

def parent(dir: String) -> Result(String, Nil) {
  case string.split(dir, "/") |> list.reverse {
    [_ | rest] if rest != [] and rest != [""] ->
      Ok(rest |> list.reverse |> string.join("/"))
    _ -> Error(Nil)
  }
}

/// A project for a loose `.bea` file outside of any project.
pub def script(file: String) -> Project {
  file = system.absolute_path(file)
  dir = parent(file) |> result.unwrap(".")
  Project(
    root: dir,
    src_dir: dir,
    build_dir: dir <> "/" <> build_dir_name,
    name: "bea_script",
    script: True,
    config: default_config("bea_script"),
  )
}

/// Reads the top level `name = "..."` from a TOML config.
pub def package_name(config: String) -> Result(String, Nil) {
  config
  |> string.split("\n")
  |> list.take_while(fn(l) { not string.starts_with(string.trim(l), "[") })
  |> list.find_map(fn(line) {
    case string.split_once(string.trim(line), "=") {
      Ok((key, value)) -> case string.trim(key) {
        "name" ->
          value
          |> string.trim
          |> string.replace("\"", "")
          |> string.replace("'", "")
          |> Ok
        _ -> Error(Nil)
      }
      Error(_) -> Error(Nil)
    }
  })
}

// --- Modules -----------------------------------------------------------------

pub type Module {
  Module(
    /// Gleam module name, e.g. `app/util`.
    name: String,
    /// Absolute path of the `.bea` file.
    bea_path: String,
    /// Absolute path of the generated `.gleam` file.
    gleam_path: String,
    source: String,
    map: SourceMap,
  )
}

pub type FileErrors {
  FileErrors(path: String, source: String, diagnostics: List(Diagnostic))
}

pub type Sync {
  Sync(
    /// Compiled Bea modules keyed by the absolute path of their Gleam file.
    modules: Dict(String, Module),
    errors: List(FileErrors),
    warnings: List(FileErrors),
    /// Files in the build directory whose content changed in this sync.
    written: List(String),
    /// What code generation knew about the project's modules (the language
    /// server compiles edited copies of a module with it).
    context: codegen.Context,
  )
}

/// Extensions copied verbatim into the Gleam project.
const passthrough = [
  ".gleam",
  ".erl",
  ".hrl",
  ".ex",
  ".mjs",
  ".js",
  ".cjs",
  ".ts",
  ".mts",
  ".d.ts",
  ".d.mts",
]

def is_passthrough(path: String) -> Bool {
  list.any(passthrough, fn(ext) { string.ends_with(path, ext) })
}

/// Write a file only if its content changed. Returns whether it was written.
pub def write_if_changed(path: String, content: String) -> Bool {
  case simplifile.read(path) {
    Ok(existing) if existing == content -> False
    _ -> {
      _ = simplifile.create_directory_all(dirname(path))
      _ = simplifile.write(path, content)
      True
    }
  }
}

pub def dirname(path: String) -> String {
  parent(path) |> result.unwrap(".")
}

/// Mirror configuration into the build directory (and manifest both ways).
pub def sync_config(project: Project) -> Nil {
  _ = simplifile.create_directory_all(project.build_dir <> "/src")
  write_if_changed(project.build_dir <> "/gleam.toml", project.config)
  case project.script {
    True -> Nil
    False -> {
      root_manifest = project.root <> "/manifest.toml"
      build_manifest = project.build_dir <> "/manifest.toml"
      case simplifile.read(root_manifest) {
        Ok(m) -> {
          write_if_changed(build_manifest, m)
          Nil
        }
        Error(_) -> Nil
      }
    }
  }
}

/// Copy files Gleam may have changed (`gleam add` & co) back to the project.
pub def sync_back(project: Project, include_config: Bool) -> Nil {
  case project.script {
    True -> Nil
    False -> {
      case simplifile.read(project.build_dir <> "/manifest.toml") {
        Ok(m) -> {
          write_if_changed(project.root <> "/manifest.toml", m)
          Nil
        }
        Error(_) -> Nil
      }
      case include_config {
        True -> case simplifile.read(project.build_dir <> "/gleam.toml") {
          Ok(c) -> {
            write_if_changed(project.root <> "/" <> config_file, c)
            Nil
          }
          Error(_) -> Nil
        }
        False -> Nil
      }
    }
  }
}

/// Recursively list source files, skipping hidden and build directories.
pub def source_files(dir: String) -> List(String) {
  case simplifile.read_directory(dir) {
    Error(_) -> []
    Ok(entries) ->
      entries
      |> list.sort(string.compare)
      |> list.flat_map(fn(entry) {
        path = dir <> "/" <> entry
        case string.starts_with(entry, "."), simplifile.is_directory(path) {
          True, _ -> []
          False, Ok(True) -> case entry == "build" or entry == "node_modules" {
            True -> []
            False -> source_files(path)
          }
          False, _ -> [path]
        }
      })
  }
}

pub def module_name(project: Project, path: String) -> String {
  path
  |> string.drop_start(string.length(project.src_dir) + 1)
  |> strip_extension
}

def strip_extension(path: String) -> String {
  case string.ends_with(path, ".bea") {
    True -> string.drop_end(path, 4)
    False -> path
  }
}

/// Is `name` a valid Gleam module path (`app/util`)?
pub def valid_module_name(name: String) -> Bool {
  string.split(name, "/")
  |> list.all(fn(segment) {
    case string.to_graphemes(segment) {
      [first | rest] ->
        string.contains(
          "abcdefghijklmnopqrstuvwxyz",
          first,
        ) and list.all(rest, fn(c) {
          string.contains("abcdefghijklmnopqrstuvwxyz0123456789_", c)
        })
      [] -> False
    }
  })
}

/// Compile every Bea module (overriding file contents with `overrides`,
/// used by the language server for unsaved editor buffers) and mirror all
/// sources into the build directory.
pub def sync(project: Project, overrides: Dict(String, String)) -> Sync {
  sync_cached(project, overrides, new_cache()).0
}

/// Parse and compile results from a previous sync, reused when neither the
/// source nor the cross-module context changed (the language server syncs on
/// every edit).
pub opaque type Cache {
  Cache(
    entries: Dict(String, CacheEntry),
    /// Gleam modules of the project: source and single constructors.
    gleam: Dict(String, (String, Set(String))),
  )
}

type CacheEntry {
  CacheEntry(
    source: String,
    parsed: Result(ast.Module, List(Diagnostic)),
    context_hash: Int,
    compiled: Option(Result(compiler.Compiled, List(Diagnostic))),
  )
}

pub def new_cache() -> Cache {
  Cache(dict.new(), dict.new())
}

@external(erlang, "bea_ffi", "hash")
def hash(term: a) -> Int

pub def sync_cached(
  project: Project,
  overrides: Dict(String, String),
  cache: Cache,
) -> (Sync, Cache) {
  sync_config(project)
  files = source_files(project.src_dir)
  (bea_files, other_files) = list.partition(files, fn(f) {
    string.ends_with(f, ".bea")
  })
  other_files = list.filter(other_files, is_passthrough)

  read = fn(path) {
    case dict.get(overrides, path) {
      Ok(text) -> Ok(text)
      Error(_) -> simplifile.read(path) |> result.replace_error(Nil)
    }
  }

  // Gleam modules living in src/ (hand written, or generated by tools such
  // as Marmot) are compiled with the Bea modules; code generation needs to
  // know their single-constructor types like those of Bea modules.
  gleam_modules =
    other_files
    |> list.filter(fn(f) { string.ends_with(f, ".gleam") })
    |> list.filter_map(fn(path) {
      use source <- result.map(read(path))
      singles = case dict.get(cache.gleam, path) {
        Ok((cached, singles)) if cached == source -> singles
        _ -> codegen.gleam_single_constructors(source)
      }
      (path, source, singles)
    })

  // Parse everything first so modules can learn about each other's types.
  parsed = list.map(bea_files, fn(path) {
    source = read(path) |> result.unwrap("")
    name = module_name(project, path)
    parsed = case dict.get(cache.entries, path) {
      Ok(entry) if entry.source == source -> entry.parsed
      _ -> compiler.parse(source)
    }
    (path, name, source, parsed)
  })
  gleam_singles = list.fold(gleam_modules, dict.new(), fn(acc, g) {
    case set.is_empty(g.2) {
      True -> acc
      False -> dict.insert(acc, gleam_module_name(project, g.0), g.2)
    }
  })
  ctx = codegen.Context(
    single_constructors: list.fold(parsed, gleam_singles, fn(acc, p) {
      case p.3 {
        Ok(m) -> dict.insert(acc, p.1, codegen.exported_single_constructors(m))
        Error(_) -> acc
      }
    }),
    derived: list.fold(parsed, dict.new(), fn(acc, p) {
      case p.3 {
        Ok(m) -> dict.insert(acc, p.1, deriving.exports(m))
        Error(_) -> acc
      }
    }),
    aliases: list.fold(parsed, dict.new(), fn(acc, p) {
      case p.3 {
        Ok(m) -> dict.insert(acc, p.1, deriving.portable_aliases(m))
        Error(_) -> acc
      }
    }),
  )

  gleam_names =
    other_files
    |> list.filter(fn(f) { string.ends_with(f, ".gleam") })
    |> list.map(gleam_module_name(project, _))
    |> set.from_list

  context_hash = hash(ctx)
  (
    modules,
    errors,
    warnings,
    entries,
  ) = list.fold(parsed, (dict.new(), [], [], dict.new()), fn(acc, p) {
    (modules, errors, warnings, entries) = acc
    (path, name, source, parsed) = p
    gleam_path = project.build_dir <> "/src/" <> name <> ".gleam"
    structural = case valid_module_name(name), set.contains(gleam_names, name) {
      False, _ ->
        Some(
          diagnostic.error(
            "Invalid module name",
            file_start(),
            "`" <> name <> "` is not a valid module name: use lowercase letters, digits and underscores",
          ),
        )
      _, True ->
        Some(
          diagnostic.error(
            "Duplicate module",
            file_start(),
            "both `" <> name <> ".bea` and `" <> name <> ".gleam` exist",
          ),
        )
      True, False -> None
    }
    cached = case dict.get(cache.entries, path) {
      Ok(CacheEntry(source: s, context_hash: h, compiled: Some(c) | _)) if s == source and h == context_hash ->
        Some(c)
      _ -> None
    }
    result = case structural, parsed, cached {
      Some(d), _, _ -> Error([d])
      None, Error(e), _ -> Error(e)
      None, Ok(_), Some(c) -> c
      None, Ok(m), None -> compiler.compile_module(m, ctx)
    }
    entries = dict.insert(
      entries,
      path,
      CacheEntry(source, parsed, context_hash, Some(result)),
    )
    case result {
      Error(diags) ->
        (modules, [FileErrors(path, source, diags) | errors], warnings, entries)
      Ok(compiled) -> {
        _ = write_if_changed(gleam_path, compiled.gleam)
        module = Module(
          name: name,
          bea_path: path,
          gleam_path: gleam_path,
          source: source,
          map: sourcemap.new(compiled.mappings, source, compiled.gleam),
        )
        warnings = case compiled.warnings {
          [] -> warnings
          ws -> [FileErrors(path, source, ws) | warnings]
        }
        (dict.insert(modules, gleam_path, module), errors, warnings, entries)
      }
    }
  })

  // Copy Gleam modules and FFI files across unchanged.
  copies = list.map(other_files, fn(path) {
    rel = string.drop_start(path, string.length(project.src_dir) + 1)
    dest = project.build_dir <> "/src/" <> rel
    changed = case read(path) {
      Ok(content) -> write_if_changed(dest, content)
      Error(_) -> {
        _ = simplifile.copy_file(path, dest)
        True
      }
    }
    (dest, changed)
  })
  copied = list.map(copies, fn(c) { c.0 })
  written_copies = list.filter_map(copies, fn(c) {
    case c.1 {
      True -> Ok(c.0)
      False -> Error(Nil)
    }
  })

  // Built-in modules the project imports and doesn't define itself.
  own_modules =
    list.map(parsed, fn(p) { p.1 })
    |> set.from_list
    |> set.union(gleam_names)
  (builtin_paths, builtin_written, builtin_errors) = sync_builtins(
    project,
    parsed,
    own_modules,
  )
  errors = list.append(builtin_errors, errors)

  // Remove generated files whose source is gone. Modules that failed to
  // compile keep their previous output so editors keep working.
  failed = list.map(errors, fn(e) {
    project.build_dir <> "/src/" <> module_name(project, e.path) <> ".gleam"
  })
  keep = set.from_list(
    list.flatten([dict.keys(modules), copied, failed, builtin_paths]),
  )
  source_files(project.build_dir <> "/src")
  |> list.filter(fn(f) { is_passthrough(f) and not set.contains(keep, f) })
  |> list.each(fn(f) {
    _ = simplifile.delete(f)
    Nil
  })

  written_tests = sync_tests(project)

  (
    Sync(
      modules,
      list.reverse(errors),
      list.reverse(warnings),
      list.flatten([written_copies, builtin_written, written_tests]),
      ctx,
    ),
    Cache(
      entries,
      list.map(gleam_modules, fn(g) { (g.0, (g.1, g.2)) }) |> dict.from_list,
    ),
  )
}

/// Writes the built-in modules that the project's Bea modules import, and
/// that neither the project nor one of its dependencies defines, compiled
/// into the build directory. Returns their paths there, the ones written,
/// and an error on each such import when the project doesn't depend on the
/// package the built-in modules need.
def sync_builtins(
  project: Project,
  parsed: List((String, String, String, Result(ast.Module, List(Diagnostic)))),
  own_modules: Set(String),
) -> (List(String), List(String), List(FileErrors)) {
  has_dependency = depends_on(project.config, builtins.dependency)
  (paths, written, errors) = list.fold(builtins.modules(), ([], [], []), fn(
    acc,
    builtin,
  ) {
    (paths, written, errors) = acc
    (name, source) = builtin
    importers = list.filter_map(parsed, fn(p) {
      (path, _, module_source, parsed) = p
      case parsed {
        Ok(m) -> case import_span(m, name) {
          Ok(s) -> Ok((path, module_source, s))
          Error(_) -> Error(Nil)
        }
        Error(_) -> Error(Nil)
      }
    })
    provided =
      set.contains(own_modules, name) or dependency_defines(project, name)
    case importers, provided, has_dependency {
      [], _, _ | _, True, _ -> acc
      _, False, False -> {
        missing = list.map(importers, fn(i) {
          (path, module_source, s) = i
          diagnostic =
            diagnostic.error(
              "Missing dependency",
              s,
              "`" <> name <> "` is built into Bea, and needs the `" <> builtins.dependency <> "` package",
            )
            |> diagnostic.with_hint(
              "Add it to the project: `bea add " <> builtins.dependency <> "`.",
            )
          (path, module_source, diagnostic)
        })
        (paths, written, list.append(errors, missing))
      }
      _, False, True -> {
        gleam_path = project.build_dir <> "/src/" <> name <> ".gleam"
        // The built-in sources are tested to compile; a failure would be a
        // bug in Bea itself.
        message = "built-in module " <> name <> " doesn't compile"
        Ok(compiled) = compiler.compile(source, codegen.empty_context())
          else panic as message
        _ = simplifile.create_directory_all(dirname(gleam_path))
        written = case write_if_changed(gleam_path, compiled.gleam) {
          True -> [gleam_path | written]
          False -> written
        }
        ([gleam_path | paths], written, errors)
      }
    }
  })
  // One entry per file, its diagnostics in source order.
  file_errors =
    errors
    |> list.map(fn(e) { e.0 })
    |> list.unique
    |> list.map(fn(path) {
      mine = list.filter(errors, fn(e) { e.0 == path })
      source =
        list.first(mine) |> result.map(fn(e) { e.1 }) |> result.unwrap("")
      diagnostics =
        list.map(mine, fn(e) { e.2 })
        |> list.sort(fn(a, b) { int.compare(a.span.start, b.span.start) })
      FileErrors(path, source, diagnostics)
    })
  (paths, written, file_errors)
}

/// Where a module imports `name`, if it does.
def import_span(module: ast.Module, name: String) -> Result(span.Span, Nil) {
  list.find_map(module.items, fn(item) {
    case item {
      ast.Import(span: s, module: m | _) if m == name -> Ok(s)
      _ -> Error(Nil)
    }
  })
}

/// Whether a downloaded dependency has a module called `name`.
def dependency_defines(project: Project, name: String) -> Bool {
  packages = project.build_dir <> "/build/packages"
  case simplifile.read_directory(packages) {
    Ok(entries) ->
      list.any(entries, fn(package) {
        simplifile.is_file(
          packages <> "/" <> package <> "/src/" <> name <> ".gleam",
        ) == Ok(True)
      })
    Error(_) -> False
  }
}

/// Whether a `bea.toml` lists `package` under `[dependencies]`.
pub def depends_on(config: String, package: String) -> Bool {
  config
  |> string.split("\n")
  |> list.fold((False, False), fn(acc, line) {
    (in_dependencies, found) = acc
    line = string.trim(line)
    cond {
      string.starts_with(line, "[") -> (line == "[dependencies]", found)
      in_dependencies and dependency_key(line) == package -> (True, True)
      _ -> acc
    }
  })
  |> fn(acc) { acc.1 }
}

/// The package a `name = "..."` (or `"name" = ...`) line declares.
def dependency_key(line: String) -> String {
  case string.split_once(line, "=") {
    Ok((key, _)) -> key |> string.trim |> string.replace("\"", "")
    Error(_) -> ""
  }
}

/// Mirrors the project's `test/` into the build directory: its Gleam
/// modules and FFI files, unchanged. Gleam compiles a project's tests along
/// with it, and `bea test` runs them. Returns the files written. (Script
/// mode has no tests.)
def sync_tests(project: Project) -> List(String) {
  case project.script {
    True -> []
    False -> {
      source = project.root <> "/test"
      dest = project.build_dir <> "/test"
      files = source_files(source) |> list.filter(is_passthrough)
      copies = list.map(files, fn(path) {
        to = dest <> "/" <> string.drop_start(path, string.length(source) + 1)
        changed = case simplifile.read(path) {
          Ok(content) -> write_if_changed(to, content)
          Error(_) -> {
            _ = simplifile.create_directory_all(dirname(to))
            _ = simplifile.copy_file(path, to)
            True
          }
        }
        (to, changed)
      })
      keep = set.from_list(list.map(copies, fn(c) { c.0 }))
      source_files(dest)
      |> list.filter(fn(f) { is_passthrough(f) and not set.contains(keep, f) })
      |> list.each(fn(f) {
        _ = simplifile.delete(f)
        Nil
      })
      list.filter_map(copies, fn(c) {
        case c.1 {
          True -> Ok(c.0)
          False -> Error(Nil)
        }
      })
    }
  }
}

def gleam_module_name(project: Project, path: String) -> String {
  string.drop_start(path, string.length(project.src_dir) + 1)
  |> string.drop_end(6)
}

/// Path in the build directory that a passthrough source file is copied to.
pub def copied_path(project: Project, source: String) -> String {
  project.build_dir <> "/src/" <> string.drop_start(
    source,
    string.length(project.src_dir) + 1,
  )
}

/// The original source of a copied passthrough file, if it is one.
pub def original_path(project: Project, built: String) -> Option(String) {
  prefix = project.build_dir <> "/src/"
  case string.starts_with(built, prefix) and not string.ends_with(
    built,
    ".bea",
  ) {
    True ->
      Some(
        project.src_dir <> "/" <> string.drop_start(
          built,
          string.length(prefix),
        ),
      )
    False -> None
  }
}

/// Whole-file problems are reported at the start of the file.
def file_start() -> span.Span {
  span.Span(0, 0)
}

/// Does a dependency directory exist yet (has `gleam deps download` run)?
pub def has_deps(project: Project) -> Bool {
  simplifile.is_directory(project.build_dir <> "/build/packages")
  |> result.unwrap(False)
}

pub def display_path(path: String) -> String {
  cwd = system.cwd() <> "/"
  case string.starts_with(path, cwd) {
    True -> string.drop_start(path, string.length(cwd))
    False -> path
  }
}

pub def modules_by_name(sync: Sync) -> Dict(String, Module) {
  sync.modules
  |> dict.values
  |> list.map(fn(m) { (m.name, m) })
  |> dict.from_list
}

pub def option_module(sync: Sync, gleam_path: String) -> Option(Module) {
  dict.get(sync.modules, gleam_path) |> option.from_result
}
