//// The `bea` command line interface.
////
//// Most commands work by syncing the Bea project into its generated Gleam
//// project (`.beabuild/`) and then delegating to the `gleam` executable,
//// translating Gleam's output back to `.bea` locations on the way.

import bea/codegen
import bea/compiler
import bea/diagnostic
import bea/docs
import bea/entrypoint
import bea/formatter
import bea/gleam_output
import bea/highlight
import bea/imports
import bea/lsp/index
import bea/lsp/server as lsp
import bea/pack
import bea/project.{type Project}
import bea/shell
import bea/style
import bea/system
import gleam/dict
import gleam/int
import gleam/io
import gleam/list
import gleam/option.{type Option, None, Some}
import gleam/result
import gleam/string
import simplifile
import gleam/erlang/atom

def version() -> String {
  system.app_version(atom.create("bea"))
}

pub def main(args: List(String)) -> Int {
  case args {
    [] | ["help"] | ["--help"] | ["-h"] -> {
      io.println(help())
      0
    }
    ["--version"] | ["-V"] | ["version"] -> {
      io.println(
        case colour() {
          True -> style.accent("bea") <> " " <> version()
          False -> "bea " <> version()
        },
      )
      0
    }
    ["new" | rest] -> new(rest)
    ["add" | rest] -> deps_change("add", rest, True)
    ["remove" | rest] -> deps_change("remove", rest, True)
    ["update" | rest] -> deps_change("update", rest, False)
    ["deps" | rest] -> passthrough(["deps" | rest], False)
    ["clean"] -> clean()
    ["check" | rest] -> compile_command("check", rest)
    ["build" | rest] -> compile_command("build", rest)
    ["docs" | rest] -> docs_command(rest)
    ["run" | rest] -> run(rest)
    ["format" | rest] | ["fmt" | rest] -> format(rest)
    ["transpile" | rest] -> transpile(rest)
    ["export" | rest] -> passthrough(["export" | rest], True)
    ["pack" | rest] -> pack_command(rest)
    ["test" | rest] -> test_command(rest)
    ["publish" | rest] -> publish(rest)
    ["hex" | rest] -> hex(rest)
    ["shell" | _] | ["repl" | _] -> shell_command()
    ["lsp" | _] -> lsp.main()
    [command | _] -> {
      error("Unknown command `" <> command <> "`")
      io.println(help())
      1
    }
  }
}

def help() -> String {
  c = colour()
  paint = fn(f: fn(String) -> String, text: String) {
    case c {
      True -> f(text)
      False -> text
    }
  }
  heading = fn(text) { paint(style.accent, text) }
  command = fn(name: String, args: String, description: String) {
    width = string.length(name) + 1 + string.length(args)
    "  " <> paint(style.highlight, name) <> " " <> paint(
      style.dim,
      args,
    ) <> string.repeat(" ", int.max(21 - width, 1)) <> description
  }
  [
    paint(style.accent, "bea") <> " " <> paint(
      style.dim,
      version(),
    ) <> " — a language that transpiles to Gleam",
    "",
    heading("Usage:") <> " bea <COMMAND> [OPTIONS]",
    "",
    heading("Project"),
    command("new", "<NAME>", "Create a new Bea project"),
    command(
      "add",
      "<PACKAGE>...",
      "Add dependencies (--dev for dev dependencies)",
    ),
    command("remove", "<PACKAGE>...", "Remove dependencies"),
    command(
      "update",
      "[PACKAGE]...",
      "Update dependencies to their latest compatible versions",
    ),
    command(
      "deps",
      "<COMMAND>",
      "Work with dependency packages (list, download, tree)",
    ),
    command("clean", "", "Delete the generated .beabuild directory"),
    "",
    heading("Building"),
    command("check", "", "Type check the project"),
    command("build", "", "Build the project"),
    command("docs", "[--out DIR]", "Generate static public API documentation"),
    command(
      "test",
      "[ARGS]",
      "Run the project's tests (test/<package>_test.gleam)",
    ),
    command(
      "run",
      "[-m MOD] [ARGS]",
      "Run a module's `main` (the project's, a file's, or a",
    ),
    "                       dependency's such as a Gleam tool; see --help)",
    command(
      "shell",
      "",
      "Start an interactive Bea shell (REPL) in the project",
    ),
    command(
      "export",
      "<WHAT>",
      "Export an escript, Erlang shipment, hex tarball, ...",
    ),
    command(
      "pack",
      "[OPTIONS]",
      "Package the project into a standalone executable",
    ),
    "                       (with gleepack; see --help)",
    "",
    heading("Code"),
    command(
      "format",
      "[PATHS]...",
      "Format Bea source files (--check, --stdin, --imports",
    ),
    "                       to also organise imports)",
    command(
      "transpile",
      "[FILE]",
      "Print the Gleam code generated for a file (or",
    ),
    "                       --stdin; --out DIR writes the whole project)",
    command("lsp", "", "Run the language server, to be used by editors"),
    "",
    heading("Publishing"),
    command("publish", "", "Publish the package to Hex (as a Gleam package)"),
    command(
      "hex",
      "<COMMAND>",
      "Hex account commands (authenticate, retire, ...)",
    ),
    "",
    paint(style.dim, "Options such as --target are passed through to Gleam."),
    paint(
      style.dim,
      "Run outside a project, `bea run file.bea` treats the file's folder as src/.",
    ),
  ]
  |> string.join("\n")
}

// --- Output helpers -------------------------------------------------------------

def colour() -> Bool {
  system.colour()
}

def error(message: String) -> Nil {
  text = case colour() {
    True -> style.error("error") <> style.bold(": " <> message)
    False -> "error: " <> message
  }
  system.print_stderr(text <> "\n")
}

/// `   Compiled in 0.3s`: a right aligned purple verb, like Gleam's.
def status(verb: String, rest: String) -> Nil {
  verb = string.pad_start(verb, 11, " ")
  verb = case colour() {
    True -> style.accent(verb)
    False -> verb
  }
  system.print_stderr(verb <> " " <> rest <> "\n")
}

def render_diagnostics(
  diagnostics: List(diagnostic.Diagnostic),
  path: String,
  source: String,
) -> String {
  diagnostic.render_all_highlighted(
    diagnostics,
    path,
    source,
    colour(),
    highlight.bea,
  )
}

def print_file_diagnostics(files: List(project.FileErrors)) -> Nil {
  list.each(files, fn(f) {
    system.print_stderr(
      render_diagnostics(
        f.diagnostics,
        project.display_path(f.path),
        f.source,
      ) <> "\n",
    )
  })
}

// --- Projects -------------------------------------------------------------------

def current_project() -> Result(Project, Nil) {
  case project.find(system.cwd()) {
    Ok(p) -> Ok(p)
    Error(_) -> {
      error(
        "No bea.toml found in this directory or any parent.\n" <> "Create a project with `bea new <name>`.",
      )
      Error(Nil)
    }
  }
}

def gleam() -> Result(String, Nil) {
  case system.gleam_executable() {
    Ok(g) -> Ok(g)
    Error(message) -> {
      error(message)
      Error(Nil)
    }
  }
}

/// Sync sources; prints Bea diagnostics and fails if there are errors.
def sync(p: Project) -> Result(project.Sync, Nil) {
  s = project.sync(p, dict.new())
  print_file_diagnostics(s.warnings)
  case s.errors {
    [] -> Ok(s)
    errors -> {
      print_file_diagnostics(errors)
      n = list.fold(errors, 0, fn(acc, f) { acc + list.length(f.diagnostics) })
      error(
        "Bea found " <> int.to_string(n) <> " error" <> case n {
          1 -> ""
          _ -> "s"
        } <> " in " <> int.to_string(
          list.length(errors),
        ) <> " file" <> case list.length(errors) {
          1 -> ""
          _ -> "s"
        },
      )
      Error(Nil)
    }
  }
}

/// Run gleam in the build directory, streaming its output through the
/// location rewriter.
def run_gleam(p: Project, s: project.Sync, args: List(String)) -> Int {
  case gleam() {
    Error(_) -> 1
    Ok(exe) -> {
      rewriter = gleam_output.new(s.modules, p.build_dir, p.src_dir, colour())
      (code, rewriter) = system.run_lines(exe, args, p.build_dir, rewriter, fn(
        r,
        line,
      ) {
        (r, lines) = gleam_output.feed(r, line)
        list.each(lines, fn(l) { system.print_stderr(l <> "\n") })
        r
      })
      list.each(gleam_output.finish(rewriter), fn(l) {
        system.print_stderr(l <> "\n")
      })
      code
    }
  }
}

/// Generate static HTML from public Bea declarations and documentation comments.
def docs_command(args: List(String)) -> Int {
  case args {
    [] | ["--out", _] -> {
      use p <- or_exit(current_project())
      out = case args {
        ["--out", dir] -> system.absolute_path(dir)
        _ -> p.root <> "/build/docs"
      }
      case docs.build(p, out) {
        Ok(count) -> {
          status("Documented", int.to_string(count) <> " modules to " <> out)
          0
        }
        Error(message) -> {
          error(message)
          1
        }
      }
    }
    _ -> {
      error("Usage: bea docs [--out DIR]")
      1
    }
  }
}

// --- Commands -------------------------------------------------------------------

def new(args: List(String)) -> Int {
  case list.filter(args, fn(a) { not string.starts_with(a, "-") }) {
    [path] -> {
      name = string.split(path, "/") |> list.last |> result.unwrap(path)
      case valid_package_name(name) {
        False -> {
          error(
            "`" <> name <> "` is not a valid project name. Use lowercase letters, digits and underscores, starting with a letter.",
          )
          1
        }
        True -> case simplifile.is_directory(path) {
          Ok(True) -> {
            error("`" <> path <> "` already exists")
            1
          }
          _ -> {
            files = [
              (
                "bea.toml",
                project.default_config(name)
                |> string.replace(
                  "\n\n[dependencies]",
                  "\n\n# description = \"\"\n# licences = [\"Apache-2.0\"]\n# repository = { type = \"github\", user = \"\", repo = \"\" }\n\n[dependencies]",
                )
                |> string.append("\n[dev_dependencies]\n"),
              ),
              (
                "src/" <> name <> ".bea",
                "import gleam/io\n\npub def main() {\n  io.println(\"Hello from " <> name <> "!\")\n}\n",
              ),
              (
                "README.md",
                "# " <> name <> "\n\nA [Bea](https://github.com/) project.\n\n```sh\nbea run   # Run the project\nbea check # Type check the project\n```\n",
              ),
              (
                ".gitignore",
                "/.beabuild\n*.beam\n*.ez\nerl_crash.dump\n/build\n",
              ),
            ]
            list.each(files, fn(f) {
              full = path <> "/" <> f.0
              _ = simplifile.create_directory_all(project.dirname(full))
              _ = simplifile.write(full, f.1)
              Nil
            })
            c = colour()
            em = fn(text) {
              case c {
                True -> style.accent(text)
                False -> text
              }
            }
            cmd = fn(text) {
              case c {
                True -> style.highlight(text)
                False -> text
              }
            }
            io.println(
              "Your Bea project " <> em(
                name,
              ) <> " has been successfully created.",
            )
            io.println(
              "The project can be compiled and run with these commands:\n",
            )
            io.println("    " <> cmd("cd " <> path))
            io.println("    " <> cmd("bea run") <> "\n")
            0
          }
        }
      }
    }
    _ -> {
      error("Usage: bea new <NAME>")
      1
    }
  }
}

def valid_package_name(name: String) -> Bool {
  case string.to_graphemes(name) {
    [first | rest] ->
      string.contains(
        "abcdefghijklmnopqrstuvwxyz",
        first,
      ) and list.all(rest, fn(c) {
        string.contains("abcdefghijklmnopqrstuvwxyz0123456789_", c)
      })
    [] -> False
  }
}

/// `add`, `remove` and `update` only touch configuration, so they don't need
/// the code to compile.
def deps_change(
  command: String,
  args: List(String),
  config_changes: Bool,
) -> Int {
  case command, list.filter(args, fn(a) { not string.starts_with(a, "-") }) {
    "add", [] | "remove", [] -> {
      error(
        "Please specify at least one package: `bea " <> command <> " <PACKAGE>...`",
      )
      1
    }
    _, _ -> {
      use p <- or_exit(current_project())
      use exe <- or_exit(gleam())
      project.sync_config(p)
      code = system.run_inherit(exe, [command | args], p.build_dir)
      project.sync_back(p, config_changes)
      case code, config_changes {
        0, True -> status("Updated", project.config_file)
        _, _ -> Nil
      }
      code
    }
  }
}

def or_exit(r: Result(a, Nil), next: fn(a) -> Int) -> Int {
  case r {
    Ok(v) -> next(v)
    Error(_) -> 1
  }
}

def passthrough(args: List(String), needs_sources: Bool) -> Int {
  use p <- or_exit(current_project())
  case needs_sources {
    True -> {
      use s <- or_exit(sync(p))
      code = run_gleam(p, s, args)
      project.sync_back(p, False)
      case args {
        ["export" | _] if code == 0 ->
          status(
            "Exported",
            "to " <> project.display_path(p.build_dir <> "/build"),
          )
        _ -> Nil
      }
      code
    }
    False -> {
      use exe <- or_exit(gleam())
      project.sync_config(p)
      code = system.run_inherit(exe, args, p.build_dir)
      project.sync_back(p, False)
      code
    }
  }
}

def clean() -> Int {
  use p <- or_exit(current_project())
  _ = simplifile.delete(p.build_dir)
  _ = simplifile.delete(p.root <> "/build")
  status("Cleaned", project.display_path(p.build_dir))
  0
}

def compile_command(command: String, args: List(String)) -> Int {
  use p <- or_exit(current_project())
  use s <- or_exit(sync(p))
  code = run_gleam(p, s, [command | args])
  project.sync_back(p, False)
  code
}

def run(args: List(String)) -> Int {
  case entrypoint.parse_run_args(args) {
    Error(message) -> {
      error(message)
      1
    }
    Ok(a) if a.help -> {
      io.println(entrypoint.help())
      0
    }
    Ok(a) -> run_parsed(a)
  }
}

def run_parsed(a: entrypoint.RunArgs) -> Int {
  resolved = case a.file {
    Some(f) -> case project.find(project.dirname(system.absolute_path(f))) {
      Ok(p) -> Ok(p)
      Error(_) -> Ok(project.script(f))
    }
    None -> current_project()
  }
  use p <- or_exit(resolved)
  module = case a.module, a.file {
    Some(m), _ -> m
    None, Some(f) -> project.module_name(p, system.absolute_path(f))
    None, None -> default_module(p) |> option.unwrap(p.name)
  }
  use _ <- or_exit(
    entrypoint.check_module_name(module) |> result.map_error(report),
  )
  (target, runtime) = run_target(p, a.target, a.runtime)
  use s <- or_exit(sync(p))
  // Build in .beabuild/, then run the program ourselves from the project
  // root (not from .beabuild/ like `gleam run` would), so relative paths,
  // `.env` files & co resolve against the user's project. Nothing runs
  // unless the build succeeded and produced the module.
  code = case run_gleam(p, s, ["build" | a.build_flags]) {
    0 -> case system.was_interrupted() {
      // Ctrl+C while building: don't start the program.
      Ok(code) -> code
      Error(_) -> case entrypoint.find(p, target, module) {
        Error(problem) -> {
          report(problem)
          1
        }
        Ok(runnable) -> {
          start = fn() {
            run_program(p, s, target, runtime, runnable, a.program_args)
          }
          case runnable.package == p.name {
            True -> start()
            // A dependency's module, typically a tool: give it the
            // project's configuration where Gleam tools look for it.
            False -> entrypoint.with_tool_config(p, start)
          }
        }
      }
    }
    code -> code
  }
  project.sync_back(p, False)
  code
}

def report(problem: entrypoint.Problem) -> Nil {
  error(problem.message)
  case problem.hint {
    Some(hint) ->
      system.print_stderr(
        case colour() {
          True -> style.accent("hint")
          False -> "hint"
        } <> ": " <> hint <> "\n",
      )
    None -> Nil
  }
}

/// The compile target and JavaScript runtime for `bea run`.
def run_target(
  p: Project,
  target: Option(String),
  runtime: Option(String),
) -> (entrypoint.Target, String) {
  parse_target = fn(t) {
    case t {
      "javascript" | "js" -> entrypoint.JavaScript
      _ -> entrypoint.Erlang
    }
  }
  target = case target {
    Some(t) -> parse_target(t)
    None -> parse_target(config_value(p.config, "target") |> option.unwrap(""))
  }
  runtime = case runtime {
    Some(r) -> r
    None -> config_value(p.config, "runtime") |> option.unwrap("nodejs")
  }
  (target, runtime)
}

/// A `key = "value"` from the configuration (top-level keys only).
def config_value(config: String, key: String) -> Option(String) {
  config
  |> string.split("\n")
  |> list.take_while(fn(line) {
    not string.starts_with(string.trim(line), "[")
  })
  |> list.find_map(fn(line) {
    case string.split_once(line, "=") {
      Ok((k, v)) if k != "" -> case string.trim(k) == key {
        True -> case string.trim(v) {
          "\"" <> quoted ->
            string.split_once(quoted, "\"")
            |> result.map(fn(parts) { parts.0 })
          bare ->
            Ok(
              string.split_once(bare, "#")
              |> result.map(fn(parts) { string.trim(parts.0) })
              |> result.unwrap(bare),
            )
        }
        False -> Error(Nil)
      }
      _ -> Error(Nil)
    }
  })
  |> option.from_result
}

/// Run `main` of a built module, the way `gleam run` does: on Erlang through
/// the `<package>@@main` entrypoint Gleam generates for the project (it
/// starts the application so `application:get_key/2` & co work, and prints
/// panics nicely; it runs dependencies' modules too, as for `gleam run -m`),
/// on JavaScript through a small entry module.
def run_program(
  p: Project,
  s: project.Sync,
  target: entrypoint.Target,
  runtime: String,
  runnable: entrypoint.Runnable,
  program_args: List(String),
) -> Int {
  rewriter = gleam_output.new(s.modules, p.build_dir, p.src_dir, colour())
  module = runnable.module
  command = case target {
    entrypoint.Erlang -> {
      lib = p.build_dir <> "/build/dev/erlang"
      ebin =
        simplifile.read_directory(lib)
        |> result.unwrap([])
        |> list.sort(string.compare)
        |> list.filter_map(fn(dir) {
          path = lib <> "/" <> dir <> "/ebin"
          case simplifile.is_directory(path) {
            Ok(True) -> Ok(["-pa", path])
            _ -> Error(Nil)
          }
        })
        |> list.flatten
      erlang_module = string.replace(module, "/", "@")
      Ok(
        (
          "erl",
          list.flatten([
            ebin,
            [
              // No BREAK menu if a Ctrl+C reaches the program: just stop.
              "+Bd",
              "-eval",
              "'" <> p.name <> "@@main':run('" <> erlang_module <> "')",
              "-noshell",
              "-extra",
            ],
            program_args,
          ]),
        ),
      )
    }
    entrypoint.JavaScript -> {
      dir = p.build_dir <> "/build/dev/javascript/" <> p.name
      entry = dir <> "/bea@@main.mjs"
      from = case runnable.package == p.name {
        True -> "./"
        False -> "../" <> runnable.package <> "/"
      }
      project.write_if_changed(
        entry,
        "import { main } from \"" <> from <> module <> ".mjs\";\nmain();\n",
      )
      case runtime {
        "deno" -> Ok(("deno", ["run", "--allow-all", entry | program_args]))
        "bun" -> Ok(("bun", ["run", entry | program_args]))
        _ -> Ok(("node", [entry | program_args]))
      }
    }
  }
  found = result.try(command, fn(c) {
    case system.find_executable(c.0) {
      Ok(exe) -> Ok((exe, c.1))
      Error(_) -> Error("`" <> c.0 <> "` was not found on your PATH")
    }
  })
  case found {
    Error(message) -> {
      error(message)
      1
    }
    Ok((exe, args)) -> {
      (
        code,
        rewriter,
      ) = system.run_stderr_lines(exe, args, p.root, rewriter, fn(r, line) {
        (r, lines) = gleam_output.feed(r, line)
        list.each(lines, fn(l) { system.print_stderr(l <> "\n") })
        r
      })
      list.each(gleam_output.finish(rewriter), fn(l) {
        system.print_stderr(l <> "\n")
      })
      code
    }
  }
}

/// Gleam runs the module named after the package; for compatibility with
/// earlier Bea projects we also accept `src/main.bea`.
def default_module(p: Project) -> Option(String) {
  has = fn(name) {
    result.unwrap(
      simplifile.is_file(p.src_dir <> "/" <> name <> ".bea"),
      False,
    ) or result.unwrap(
      simplifile.is_file(p.src_dir <> "/" <> name <> ".gleam"),
      False,
    )
  }
  case has(p.name), has("main") {
    True, _ -> None
    False, True -> Some("main")
    False, False -> None
  }
}

def format(args: List(String)) -> Int {
  check = list.contains(args, "--check")
  stdin = list.contains(args, "--stdin")
  organize = list.contains(args, "--imports")
  paths = list.filter(args, fn(a) { not string.starts_with(a, "--") })
  // `--imports` organises imports first, like the language server does when
  // formatting: grouped, sorted, unused ones removed, obvious ones added.
  prepare = fn(path: String, source: String) {
    case organize {
      False -> source
      True -> case project.find(project.dirname(system.absolute_path(path))) {
        Error(_) -> imports.organize(source, imports.nothing_known())
        Ok(p) -> {
          deps = case project.has_deps(p) {
            True -> Some(index.dependencies(p))
            False -> None
          }
          known = imports.for_project(p, deps, system.absolute_path(path), fn(
            _,
          ) { Error(Nil) })
          imports.organize(source, known)
        }
      }
    }
  }
  case stdin {
    True -> {
      source = system.read_stdin()
      case formatter.format(prepare(system.cwd() <> "/stdin.bea", source)) {
        Ok(formatted) -> {
          system.print(formatted)
          case check and formatted != source {
            True -> 1
            False -> 0
          }
        }
        Error(diags) -> {
          system.print_stderr(render_diagnostics(diags, "<stdin>", source))
          1
        }
      }
    }
    False -> {
      paths = case paths {
        [] -> case project.find(system.cwd()) {
          Ok(p) -> [p.src_dir]
          Error(_) -> ["."]
        }
        _ -> paths
      }
      files = list.flat_map(paths, fn(path) {
        case simplifile.is_directory(path) {
          Ok(True) ->
            project.source_files(path)
            |> list.filter(fn(f) { string.ends_with(f, ".bea") })
          _ -> [path]
        }
      })
      results = list.map(files, fn(file) {
        case simplifile.read(file) {
          Error(_) -> {
            error("Could not read " <> file)
            (file, False, True)
          }
          Ok(source) -> case formatter.format(prepare(file, source)) {
            Error(diags) -> {
              system.print_stderr(
                render_diagnostics(diags, project.display_path(file), source),
              )
              (file, False, True)
            }
            Ok(formatted) if formatted == source -> (file, False, False)
            Ok(formatted) -> {
              case check {
                True -> Nil
                False -> {
                  _ = simplifile.write(file, formatted)
                  Nil
                }
              }
              (file, True, False)
            }
          }
        }
      })
      failed = list.any(results, fn(r) { r.2 })
      changed = list.filter(results, fn(r) { r.1 })
      case check, changed {
        True, [_ | _] -> {
          error("These files have not been formatted:\n")
          list.each(changed, fn(r) {
            system.print_stderr("  - " <> project.display_path(r.0) <> "\n")
          })
          1
        }
        _, _ -> case failed {
          True -> 1
          False -> 0
        }
      }
    }
  }
}

/// Show the Gleam generated for a file, or write the whole generated
/// project somewhere (an "eject" to plain Gleam).
def transpile(args: List(String)) -> Int {
  case args {
    ["--out", dir] -> {
      use p <- or_exit(current_project())
      use s <- or_exit(sync(p))
      _ = s
      _ = simplifile.create_directory_all(dir)
      _ = simplifile.copy_directory(p.build_dir <> "/src", dir <> "/src")
      _ = simplifile.copy_file(
        p.build_dir <> "/gleam.toml",
        dir <> "/gleam.toml",
      )
      _ = simplifile.copy_file(
        p.build_dir <> "/manifest.toml",
        dir <> "/manifest.toml",
      )
      case gleam() {
        Ok(exe) -> {
          _ = system.run_lines(exe, ["format", "src"], dir, Nil, fn(_, _) {
            Nil
          })
          Nil
        }
        Error(_) -> Nil
      }
      status("Wrote", dir)
      0
    }
    ["--stdin"] -> transpile_source(system.read_stdin(), "<stdin>")
    [file] -> case simplifile.read(file) {
      Error(_) -> {
        error("Could not read " <> file)
        1
      }
      Ok(source) -> transpile_source(source, file)
    }
    _ -> {
      error(
        "Usage: bea transpile <FILE.bea> | bea transpile --stdin | bea transpile --out <DIR>",
      )
      1
    }
  }
}

def transpile_source(source: String, name: String) -> Int {
  case compiler.compile(source, codegen.empty_context()) {
    Ok(c) -> {
      // Highlighted on a terminal; plain when piped (editors read it).
      io.print(
        case colour() {
          True -> highlight.gleam(c.gleam)
          False -> c.gleam
        },
      )
      0
    }
    Error(diags) -> {
      system.print_stderr(render_diagnostics(diags, name, source))
      1
    }
  }
}

/// `bea shell`: the project's shell, or (outside a project) one in a
/// scratch project kept in the user's cache directory.
def shell_command() -> Int {
  resolved = case project.find(system.cwd()) {
    Ok(p) -> Ok(p)
    Error(_) -> scratch_project()
  }
  use p <- or_exit(resolved)
  use exe <- or_exit(gleam())
  // GSH evaluates on the Erlang target, whatever the project's default.
  build = fn() {
    case sync(p) {
      Error(_) -> False
      Ok(s) -> run_gleam(p, s, ["build", "--target", "erlang"]) == 0
    }
  }
  case build() {
    False -> 1
    True -> shell.start(p, exe, build)
  }
}

def scratch_project() -> Result(Project, Nil) {
  cache = case system.get_env("XDG_CACHE_HOME"), system.get_env("HOME") {
    Ok(dir), _ -> dir
    _, Ok(home) -> home <> "/.cache"
    _, _ -> "/tmp"
  }
  dir = cache <> "/bea/shell"
  _ = simplifile.create_directory_all(dir <> "/src")
  config = dir <> "/" <> project.config_file
  case simplifile.is_file(config) {
    Ok(True) -> Nil
    _ -> {
      _ = simplifile.write(config, project.default_config("bea_shell"))
      _ = simplifile.write(
        dir <> "/src/bea_shell.bea",
        "// Scratch project of `bea shell` outside a project.\npub def main() {\n  Nil\n}\n",
      )
      Nil
    }
  }
  project.find(dir)
}

/// Bea packages are published to Hex as the Gleam code they compile to, so
/// both Gleam and Bea projects can depend on them.
const test_help = "Usage: bea test [OPTIONS] [ARGS]

Run the project's tests: the `main` of test/<package>_test.gleam (with
gleeunit, for example), built with the project and run from the project
root, so tests read files relative to it. The project's test/ holds Gleam
test modules and FFI files.

Options are those of `bea run` (--target, --runtime, and flags for the
build); the remaining arguments are passed to the tests."

/// `bea test`: the project's tests, run like `bea run -m <package>_test`.
def test_command(args: List(String)) -> Int {
  case entrypoint.parse_run_args(args) {
    Error(message) -> {
      error(message)
      1
    }
    Ok(a) if a.help -> {
      io.println(test_help)
      0
    }
    Ok(a) if a.module != None or a.file != None -> {
      error(
        "`bea test` runs the project's tests module; use `bea run -m` for another module",
      )
      1
    }
    Ok(a) -> {
      use p <- or_exit(current_project())
      module = p.name <> "_test"
      case system.file_exists(p.root <> "/test/" <> module <> ".gleam") {
        True -> run_parsed(entrypoint.RunArgs(a | module: Some(module)))
        False -> {
          error(
            "No tests: `bea test` runs the `main` of test/" <> module <> ".gleam",
          )
          system.print_stderr(
            "hint: add test/" <> module <> ".gleam, e.g. with gleeunit (`bea add --dev gleeunit`):\n\n    import gleeunit\n\n    pub fn main() {\n      gleeunit.main()\n    }\n",
          )
          1
        }
      }
    }
  }
}

/// `bea pack`: the project as a standalone executable, built by gleepack in
/// the generated Gleam project (see bea/pack).
def pack_command(args: List(String)) -> Int {
  case pack.parse(args) {
    Ok(pack.Help) -> {
      io.println(pack.help())
      0
    }
    Ok(pack.Pack(options)) -> pack_project(options)
    Error(message) -> {
      error(message <> "\n" <> pack.usage)
      1
    }
  }
}

def pack_project(options: pack.Options) -> Int {
  use p <- or_exit(current_project())
  manifest = simplifile.read(p.root <> "/manifest.toml") |> option.from_result
  packer = case pack.find(manifest) {
    Ok(packer) -> Ok(packer)
    Error(message) -> {
      error(message)
      Error(Nil)
    }
  }
  use packer <- or_exit(packer)
  use exe <- or_exit(gleam())
  use s <- or_exit(sync(p))
  // Built first so that errors are reported on the .bea files; gleepack then
  // compiles the same Gleam for its own runtime.
  case run_gleam(p, s, ["build", "--target", "erlang"]) {
    0 -> {
      output =
        pack.output_path(p, options, system.cwd())
        |> pack.gleepack_output(pack.targets(p, options))
      _ = simplifile.create_directory_all(project.dirname(output))
      status("Packing", p.name <> " with gleepack")
      (command, args) = pack.command(
        packer,
        exe,
        pack.gleepack_args(options, output),
      )
      code = system.run_inherit(command, args, p.build_dir)
      project.sync_back(p, False)
      code
    }
    code -> code
  }
}

/// `bea hex ...`: Gleam's Hex commands, which ask for passwords on the
/// terminal.
def hex(args: List(String)) -> Int {
  use p <- or_exit(current_project())
  use exe <- or_exit(gleam())
  project.sync_config(p)
  code = system.run_interactive(exe, ["hex" | args], p.build_dir)
  project.sync_back(p, False)
  code
}

def publish(args: List(String)) -> Int {
  use p <- or_exit(current_project())
  use _ <- or_exit(sync(p))
  use exe <- or_exit(gleam())
  [
    "README.md",
    "README",
    "LICENSE",
    "LICENCE",
    "LICENSE.md",
    "LICENCE.md",
    "LICENSE.txt",
    "CHANGELOG.md",
  ]
  |> list.each(fn(f) {
    case simplifile.read(p.root <> "/" <> f) {
      Ok(content) -> {
        project.write_if_changed(p.build_dir <> "/" <> f, content)
        Nil
      }
      Error(_) -> Nil
    }
  })
  status("Publishing", p.name <> " (as Gleam code generated from Bea)")
  // Gleam asks for the Hex password on the terminal.
  code = system.run_interactive(exe, ["publish" | args], p.build_dir)
  project.sync_back(p, False)
  code
}
