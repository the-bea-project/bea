//// Embedded offline documentation assets.

pub const css = "*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#0b1016;color:#e5e9f3;font:15px/1.7 system-ui,-apple-system,Segoe UI,sans-serif}a{color:#75dce7;text-decoration:none}a:hover{text-decoration:underline}button,input{font:inherit}button{cursor:pointer}.topbar{height:68px;position:sticky;top:0;z-index:10;background:#101821;border-bottom:1px solid #2a3b45;display:flex;align-items:center;gap:14px;padding:0 24px}.brand{display:flex;align-items:center;gap:12px;font-size:17px;font-weight:750;color:#f6f4ff}.brand img{width:38px;height:38px;object-fit:contain}.topbar .package{color:#9fa9bc;font-size:13px;margin-left:auto}.layout{display:grid;grid-template-columns:260px minmax(0,1fr);min-height:calc(100vh - 68px)}.sidebar{border-right:1px solid #2a3b45;padding:24px 16px;background:#0d151d;position:sticky;top:68px;max-height:calc(100vh - 68px);overflow:auto}.sidebar .section-title{font-size:11px;color:#8993a6;letter-spacing:.13em;text-transform:uppercase;font-weight:700;margin:16px 10px}.sidebar details{margin:3px 0}.sidebar summary{cursor:pointer;padding:6px 10px;border-radius:7px;color:#c2c9d8;font-weight:600}.sidebar summary:hover{background:#222b3b}.sidebar a{display:block;overflow-wrap:anywhere;color:#aeb8cd;font-size:13px;padding:5px 10px 5px 19px;border-radius:7px}.sidebar a:hover,.sidebar a.active{background:#163440;color:#d2f6f9;text-decoration:none}.sidebar a.hidden,.entry.hidden,.module-card.hidden,.module-group.hidden{display:none}.search{width:100%;border:1px solid #394156;border-radius:9px;background:#15232d;color:#f2f4f9;padding:9px 12px;outline:none}.search:focus{border-color:#4dbdcf;box-shadow:0 0 0 2px #4dbdcf22}.results{font-size:12px;color:#8f9cb1;padding:6px 10px}.page{width:min(1020px,100%);padding:40px 54px 100px;margin:0 auto}.eyebrow{letter-spacing:.14em;text-transform:uppercase;font-size:11px;font-weight:800;color:#77dce6}.page h1{font-size:36px;line-height:1.2;letter-spacing:-.035em;margin:8px 0 20px}.page h2{margin:35px 0 14px;font-size:23px}.page h3{margin:5px 0 10px;font-size:18px}.description{color:#c6cddd}.description h2,.description h3{color:#e6eafa}.description p{margin:10px 0}.description ul,.description ol{padding-left:25px}.description blockquote{border-left:3px solid #2caebf;padding:3px 16px;margin:16px 0;color:#abb5c6;background:#1a202d}.description code:not(pre code){color:#e7c99b;background:#25313b;border-radius:4px;padding:2px 5px;font-size:.89em}.description a{text-decoration:underline;text-underline-offset:3px}.entry{border-top:1px solid #2a3b45;padding:24px 0;scroll-margin-top:90px}.entry .signature{margin:12px 0 15px}.code-shell{position:relative;margin:14px 0 18px}.code-toolbar{display:flex;align-items:center;justify-content:space-between;background:#192934;border:1px solid #374155;border-bottom:0;border-radius:10px 10px 0 0;padding:5px 12px;color:#9eabc4;font:12px ui-monospace,monospace}.wrap-toggle{background:transparent;border:1px solid #49526a;border-radius:5px;color:#cbd2e3;padding:2px 8px;font-size:11px}.wrap-toggle:hover{border-color:#79deea}.code-shell pre{margin:0;background:#121e27;border:1px solid #374155;border-radius:0 0 10px 10px;padding:16px 20px;overflow-x:auto;tab-size:2;white-space:pre;font:13px/1.65 ui-monospace,SFMono-Regular,Consolas,monospace}.code-shell pre.wrapped{white-space:pre-wrap;overflow-wrap:anywhere}.tok-keyword{color:#f5c26e}.tok-string{color:#a4e8ad}.tok-number{color:#ffc28b}.tok-comment{color:#8391a7;font-style:italic}.tok-type{color:#74dce8}.module-card{padding:14px 18px;border:1px solid #30394b;border-radius:10px;margin:10px 0;background:#161e2b}.module-card a{font-size:16px;font-weight:700}.module-card small{display:block;color:#9ca9bb;margin-top:4px}.empty{color:#8d98ad}.mobile-menu{display:none}.foot{margin-top:64px;border-top:1px solid #30394b;padding-top:20px;color:#8793a7;font-size:12px}@media(max-width:800px){.layout{grid-template-columns:minmax(0,1fr)}.sidebar{display:none;position:fixed;top:68px;left:0;bottom:0;width:285px;max-height:none;box-shadow:12px 0 40px #0008;z-index:20}.sidebar.open{display:block}.mobile-menu{display:block;color:#d6dbed;background:transparent;border:1px solid #455067;border-radius:6px;padding:3px 8px}.page{padding:28px 22px 70px}.topbar{padding:0 14px}.topbar .package{font-size:11px}.page h1{font-size:30px}}\n/* Document navigation: linking to an overview never collapses the module. */\n.sidebar .module-row{display:flex;align-items:center;gap:2px;border-radius:8px}\n.sidebar .module-expander{flex:none;width:25px;height:29px;border:0;background:transparent;color:#8ca7b5;padding:0;font-size:16px;transition:transform .16s}\n.sidebar .module-expander[aria-expanded=\"true\"]{transform:rotate(90deg);color:#7adddf}\n.sidebar .module-overview{flex:1;padding:6px 6px 6px 2px;font-weight:650;color:#c5dce3;min-width:0}\n.sidebar .module-row:hover{background:#1a2b35}\n.sidebar .module-children{padding-left:17px}\n.sidebar .module-children[hidden]{display:none}\n.sidebar .module-overview.active,.sidebar .overview-link.active,.sidebar .declaration-link.active{background:#173742;color:#91edf0;box-shadow:inset 3px 0 #49bdc9}\n.sidebar .module-row:has(.module-overview.active){background:#16313b}\n.sidebar .module-row .module-overview.active{box-shadow:none}\n.sidebar .module-expander:focus-visible,.sidebar a:focus-visible{outline:2px solid #74dce8;outline-offset:1px}\n/* Prominent mascot, while staying compact on phones. */\n.topbar{height:86px;background:#0e1922;border-bottom-color:#29434d}\n.brand{gap:15px;font-size:21px;letter-spacing:-.035em}\n.brand img{width:69px;height:69px;object-fit:contain;filter:drop-shadow(0 0 13px #43b7c63c)}\n.layout{min-height:calc(100vh - 86px)}\n.sidebar{top:86px;max-height:calc(100vh - 86px)}\n@media(max-width:800px){.sidebar{top:86px}.brand img{width:55px;height:55px}.brand{font-size:18px}}\n/* Code displayed as Bea is formatted automatically (no extra toggle). */\n.code-shell pre code{display:block}\n"

pub const js = "(()=>{'use strict';const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>Array.from(r.querySelectorAll(s));const esc=s=>s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;');const safeUrl=u=>/^(https?:\\/\\/|mailto:|#|\\.\\.?\\/)/i.test(u)?u:'#';function inline(text){let out=esc(text);out=out.replace(/`([^`]+)`/g,(_,v)=>'<code>'+v+'</code>');out=out.replace(/\\[([^\\]]+)\\]\\(([^\\s)]+)\\)/g,(_,label,url)=>'<a href=\"'+esc(safeUrl(url))+'\">'+label+'</a>');out=out.replace(/\\*\\*([^*]+)\\*\\*/g,'<strong>$1</strong>').replace(/\\*([^*\\n]+)\\*/g,'<em>$1</em>');return out}function markdown(source){const lines=source.replace(/\\r\\n/g,'\\n').split('\\n'),out=[];let i=0;while(i<lines.length){const x=lines[i];if(!x.trim()){i++;continue}const fence=x.match(/^\\s*(`{3,}|~{3,})\\s*([\\w+#.-]*)/);if(fence){const lang=fence[2]||'text',body=[],mark=fence[1][0],length=fence[1].length;i++;while(i<lines.length&&!new RegExp('^\\\\s*'+(mark==='`'?'`':'~')+'{'+length+',}\\\\s*$').test(lines[i]))body.push(lines[i++]);if(i<lines.length)i++;out.push('<div class=\"code-shell\"><div class=\"code-toolbar\"><span>'+esc(lang)+'</span><button class=\"wrap-toggle\" type=\"button\" aria-label=\"Toggle code wrapping\">Wrap</button></div><pre><code data-lang=\"'+esc(lang)+'\">'+esc(body.join('\\n'))+'</code></pre></div>');continue}const h=x.match(/^([#]{1,6})\\s+(.+)$/);if(h){const level=Math.min(h[1].length+1,6);out.push('<h'+level+'>'+inline(h[2])+'</h'+level+'>');i++;continue}if(/^\\s*---+\\s*$/.test(x)){out.push('<hr>');i++;continue}if(/^\\s*>\\s?/.test(x)){let v=[];while(i<lines.length&&/^\\s*>\\s?/.test(lines[i]))v.push(lines[i++].replace(/^\\s*>\\s?/,''));out.push('<blockquote>'+v.map(inline).join('<br>')+'</blockquote>');continue}const list=x.match(/^\\s*(?:([-*+])|(\\d+)\\.)\\s+(.+)$/);if(list){const ordered=!!list[2],items=[];while(i<lines.length){const m=lines[i].match(/^\\s*(?:([-*+])|(\\d+)\\.)\\s+(.+)$/);if(!m||!!m[2]!==ordered)break;items.push('<li>'+inline(m[3])+'</li>');i++}out.push('<'+(ordered?'ol':'ul')+'>'+items.join('')+'</'+(ordered?'ol':'ul')+'>');continue}let paras=[x];i++;while(i<lines.length&&lines[i].trim()&&!/^(\\s*(`{3,}|~{3,})|[#]{1,6}\\s|\\s*>|\\s*[-*+]\\s|\\s*\\d+\\.\\s|\\s*---+\\s*$)/.test(lines[i]))paras.push(lines[i++]);out.push('<p>'+inline(paras.join(' '))+'</p>')}return out.join('\\n')};$$('.markdown-source').forEach(el=>{el.innerHTML=markdown(el.textContent);el.classList.remove('markdown-source')});const keyword=/^(pub|def|fn|type|opaque|const|import|as|case|if|else|use|let|assert|todo|panic|external|return|try|True|False|Nil|Ok|Error|Some|None)$/;function highlight(source,lang){if(!/^(bea|gleam|elixir|rust|javascript|js|ts|typescript|python|bash|sh|shell|toml|json)$/i.test(lang))return esc(source);const rx=/(\\/\\/[^\\n]*|#[^\\n]*|\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|\\b\\d+(?:\\.\\d+)?\\b|\\b[A-Za-z_][A-Za-z_0-9]*\\b)/g;let result='',last=0,m;while((m=rx.exec(source))){result+=esc(source.slice(last,m.index));const w=m[0];let c='';if(w.startsWith('//')||(w.startsWith('#')&&/^(bea|gleam|python|sh|bash|shell|toml)$/.test(lang)))c='comment';else if(w[0]==='\"'||w[0]===\"'\")c='string';else if(/^\\d/.test(w))c='number';else if(keyword.test(w))c='keyword';else if(/^[A-Z]/.test(w)&&/^(bea|gleam|elixir|rust)$/.test(lang))c='type';result+=c?'<span class=\"tok-'+c+'\">'+esc(w)+'</span>':esc(w);last=rx.lastIndex}return result+esc(source.slice(last))}function formatBea(src){const lines=src.replace(/\\r\\n/g,'\\n').replace(/\\t/g,'  ').split('\\n');while(lines.length&&!lines[0].trim())lines.shift();while(lines.length&&!lines[lines.length-1].trim())lines.pop();if(!lines.length)return '';const indents=lines.filter(x=>x.trim()).map(x=>(x.match(/^ */)||[''])[0].length);const min=Math.min(...indents);let depth=0;return lines.map(line=>{const t=line.slice(min).trim();if(!t)return '';if(/^[})\\]]/.test(t))depth=Math.max(0,depth-1);const out='  '.repeat(depth)+t;const opens=(t.match(/[({]/g)||[]).length,closes=(t.match(/[)}]/g)||[]).length;depth=Math.max(0,depth+opens-closes);return out}).join('\\n')}\n$$('pre code[data-lang]').forEach(el=>{const lang=(el.dataset.lang||'text').toLowerCase();const source=lang==='bea'?formatBea(el.textContent):el.textContent;el.innerHTML=highlight(source,lang)});let wrap=false;try{wrap=localStorage.getItem('bea-docs-wrap')==='1'}catch(_){}function setWrap(v){wrap=v;$$('.code-shell pre').forEach(el=>el.classList.toggle('wrapped',v));$$('.wrap-toggle').forEach(el=>{el.textContent=v?'No wrap':'Wrap';el.setAttribute('aria-pressed',String(v))});try{localStorage.setItem('bea-docs-wrap',v?'1':'0')}catch(_){}}document.addEventListener('click',e=>{if(e.target.closest('.wrap-toggle'))setWrap(!wrap)});setWrap(wrap);const groups=$$('.module-group');\nfunction setExpanded(group,expanded){const button=$('.module-expander',group),children=$('.module-children',group);if(!button||!children)return;button.setAttribute('aria-expanded',String(expanded));children.hidden=!expanded}\nconst currentPath=decodeURI(location.pathname).replace(/\\\\/g,'/');\nconst currentFile=currentPath.split('/').pop()||'index.html';\nconst currentModule=location.pathname.match(/\\/modules\\/(.+)\\.html$/);\nconst currentName=currentModule?decodeURI(currentModule[1]):null;\ngroups.forEach(group=>{const active=group.dataset.module===currentName;setExpanded(group,active);if(active){const link=$('.module-overview',group),overview=$('.overview-link',group);if(link)link.classList.add('active');if(overview&&!location.hash)overview.classList.add('active')}});\nfunction selectHash(){const hash=location.hash;$$('.declaration-link').forEach(link=>link.classList.toggle('active',!!hash&&link.hash===hash&&link.pathname===location.pathname));if(hash){$$('.overview-link').forEach(link=>link.classList.remove('active'))}else{const g=groups.find(g=>g.dataset.module===currentName);if(g){const ov=$('.overview-link',g);if(ov)ov.classList.add('active')}}}\nselectHash();window.addEventListener('hashchange',selectHash);\ndocument.addEventListener('click',e=>{const toggle=e.target.closest('.module-expander');if(!toggle)return;const group=toggle.closest('.module-group');setExpanded(group,toggle.getAttribute('aria-expanded')!=='true')});\nconst search=$('#docs-search'),results=$('#search-count');if(search){const targets=$$('[data-search]');function update(){const q=search.value.toLocaleLowerCase().trim();let visible=0;targets.forEach(el=>{const hit=!q||(el.dataset.search||'').toLocaleLowerCase().includes(q);el.classList.toggle('hidden',!hit);if(hit)visible++});groups.forEach(group=>{const children=$$('[data-search]',group),has=children.some(el=>!el.classList.contains('hidden'));group.classList.toggle('hidden',!has);if(q&&has)setExpanded(group,true);if(!q)setExpanded(group,group.dataset.module===currentName)});if(results)results.textContent=q?visible+' matches':'Search modules and API'}search.addEventListener('input',update);const urlQ=new URLSearchParams(location.search).get('q');if(urlQ)search.value=urlQ;update()}\nconst menu=$('#mobile-menu'),sidebar=$('#docs-sidebar');if(menu&&sidebar)menu.addEventListener('click',()=>{const opened=sidebar.classList.toggle('open');menu.setAttribute('aria-expanded',String(opened))});})();"

pub const logo = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 900\" width=\"280\" height=\"280\">\n  <defs>\n    <linearGradient id=\"bh-glow\" gradientUnits=\"userSpaceOnUse\" x1=\"179.3\" y1=\"72.0\" x2=\"752.8\" y2=\"432.1\">\n      <stop offset=\"0\" stop-color=\"#FC61B9\"/>\n      <stop offset=\"0.5\" stop-color=\"#DB82DA\"/>\n      <stop offset=\"1\" stop-color=\"#B492F9\"/>\n    </linearGradient>\n    <path id=\"bh-inner\" d=\"M194.9,297.9 C196.3,291.2 211.4,286.2 217.5,283.5 C268.3,261.5 269.8,225.3 291.7,181.5 C303.7,157.6 321.3,137.0 342.5,120.7 C410.8,68.3 509.4,72.4 571.5,133.4 C615.8,176.9 611.1,222.0 683.0,237.2 C688.4,238.3 704.1,240.1 705.4,246.1 L713.8,244.9 C714.0,260.0 684.5,267.4 667.0,272.4 C550.5,305.6 356.3,322.7 235.0,315.5 C218.1,314.5 188.3,312.3 186.8,298.8 Z\"/>\n    <clipPath id=\"bh-inner-clip\"><use href=\"#bh-inner\"/></clipPath>\n    <style>\n      .blink-eyes { transform-box: view-box; transform-origin: 450px 241px; animation: beatrix-blink 6.2s infinite; }\n      @keyframes beatrix-blink { 0%, 43%, 47%, 78%, 82%, 100% { transform: scaleY(1); } 45%, 80% { transform: scaleY(.08); } }\n      @media (prefers-reduced-motion: reduce) { .blink-eyes { animation: none; } }\n    </style>\n  </defs>\n\n  <!-- This group shifts the 482px high graphic down by 209px to perfectly center it in a 900x900 canvas -->\n  <g transform=\"translate(0, 209)\">\n    <!-- lower half of the accretion disc (behind) -->\n    <circle cx=\"450.0\" cy=\"259.5\" r=\"208.7\" fill=\"url(#bh-glow)\" stroke=\"#3C2B55\" stroke-width=\"14\"/>\n    <!-- black hole (part seen below the ring) -->\n    <circle cx=\"450.0\" cy=\"258.8\" r=\"129.75\" fill=\"#000\"/>\n\n    <!-- ring + upper arch -->\n    <path d=\"M457.5,13.0 C375.4,11.6 300.5,50.1 252.4,116.5 C225.6,153.4 211.7,198.1 178.5,230.5 C146.5,261.7 112.5,267.8 72.5,282.2 C55.3,288.3 25.2,298.7 15.4,315.0 C5.9,330.9 30.8,340.1 42.0,343.4 C78.0,353.9 116.7,357.2 154.0,359.4 C335.0,370.0 525.4,353.5 702.0,312.3 C747.4,301.7 792.9,289.6 836.0,271.7 C852.0,265.0 873.0,256.8 883.2,242.0 C895.7,223.9 866.1,214.6 853.5,211.6 C807.2,200.4 758.0,205.4 715.5,181.0 C675.1,157.8 653.3,118.3 621.5,86.0 C578.5,42.2 519.5,14.0 457.5,13.0 Z\" fill=\"url(#bh-glow)\" stroke=\"#3C2B55\" stroke-width=\"14\" stroke-linejoin=\"round\"/>\n    <!-- light inner glow -->\n    <use href=\"#bh-inner\" fill=\"#FFD3E8\"/>\n    <!-- black hole (part seen above the ring) -->\n    <circle cx=\"450.0\" cy=\"258.8\" r=\"129.75\" fill=\"#000\" clip-path=\"url(#bh-inner-clip)\"/>\n    <!-- front edge of the ring -->\n    <path d=\"M186.8,298.8 C188.3,312.3 218.1,314.5 235.0,315.5 C356.3,322.7 550.5,305.6 667.0,272.4 C684.5,267.4 714.0,260.0 713.8,244.9\" fill=\"none\" stroke=\"#3C2B55\" stroke-width=\"14\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n\n    <!-- face -->\n    <g fill=\"#FAF3EC\">\n      <g class=\"blink-eyes\">\n        <circle cx=\"404.0\" cy=\"241.2\" r=\"7.3\"/>\n        <circle cx=\"503.8\" cy=\"241.2\" r=\"7.3\"/>\n      </g>\n      <path d=\"M392.2,247.4 Q393.6,251.1 397.2,252.4 Q393.6,253.8 392.2,257.4 Q390.8,253.8 387.2,252.4 Q390.8,251.1 392.2,247.4 Z\"/>\n      <path d=\"M492.3,247.5 Q493.7,251.2 497.3,252.5 Q493.7,253.8 492.3,257.5 Q490.9,253.8 487.3,252.5 Q490.9,251.2 492.3,247.5 Z\"/>\n    </g>\n    <g fill=\"#FC9A96\">\n      <ellipse cx=\"384.4\" cy=\"272.3\" rx=\"14.7\" ry=\"8\"/>\n      <ellipse cx=\"515.2\" cy=\"272.3\" rx=\"14.7\" ry=\"8\"/>\n    </g>\n    <path d=\"M434.2,266.8 A18.1,18.1 0 0 0 465.2,266.8\" fill=\"none\" stroke=\"#FAF3EC\" stroke-width=\"7.5\" stroke-linecap=\"round\"/>\n  </g>\n</svg>\n\n"
