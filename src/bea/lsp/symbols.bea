//// `textDocument/documentSymbol`, computed from the Bea syntax tree.

import bea/ast
import bea/lsp/json.{type Json}
import bea/lsp/position
import bea/span.{type LineIndex, type Span}
import gleam/list

// LSP SymbolKind values
const kind_class = 5

const kind_enum_member = 22

const kind_function = 12

const kind_constant = 14

const kind_type_parameter = 26

pub def document_symbols(module: ast.Module, index: LineIndex) -> Json {
  module.items
  |> list.filter_map(fn(item) {
    case item {
      ast.Function(span:, name:, name_span:, clauses:) -> {
        detail = case clauses {
          [_] -> "def"
          cs -> "def (" <> int_to_string(list.length(cs)) <> " clauses)"
        }
        Ok(symbol(index, name, detail, kind_function, span, name_span, []))
      }
      ast.CustomType(span:, name:, name_span:, variants: | _) ->
        Ok(
          symbol(
            index,
            name,
            "type",
            kind_class,
            span,
            name_span,
            list.map(variants, fn(v) {
              symbol(index, v.name, "", kind_enum_member, v.span, v.span, [])
            }),
          ),
        )
      ast.TypeAlias(span:, name:, name_span: | _) ->
        Ok(
          symbol(
            index,
            name,
            "type alias",
            kind_type_parameter,
            span,
            name_span,
            [],
          ),
        )
      ast.ExternalType(span:, name:, name_span: | _) ->
        Ok(
          symbol(index, name, "external type", kind_class, span, name_span, []),
        )
      ast.Const(span:, name:, name_span: | _) ->
        Ok(symbol(index, name, "const", kind_constant, span, name_span, []))
      ast.Import(| _) -> Error(Nil)
    }
  })
  |> json.Array
}

def symbol(
  index: LineIndex,
  name: String,
  detail: String,
  kind: Int,
  range: Span,
  selection: Span,
  children: List(Json),
) -> Json {
  json.object([
    ("name", json.String(name)),
    ("detail", json.String(detail)),
    ("kind", json.Int(kind)),
    ("range", position.span_to_range(index, range)),
    ("selectionRange", position.span_to_range(index, selection)),
    ("children", json.Array(children)),
  ])
}

def int_to_string(i: Int) -> String {
  case i {
    _ -> do_int(i)
  }
}

@external(erlang, "erlang", "integer_to_binary")
def do_int(i: Int) -> String
